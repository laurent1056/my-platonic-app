---
import '@/styles/global.css'
import '@/styles/storefront.css'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import DossierOffer from '@/components/DossierOffer.astro'
import { DEFAULT_DESCRIPTION, DEFAULT_SOCIAL_IMAGE, SITE_NAME, metaDescription, metaTitle } from '@/data/seo'

interface BreadcrumbItem {
  name: string
  href?: string
}

interface Props {
  title?: string
  description?: string
  current?: string
  image?: string
  imageAlt?: string
  breadcrumbs?: BreadcrumbItem[]
  noindex?: boolean
  offer?: boolean
}

const {
  title = 'Platonic Ideal — One product. Or none.',
  description = DEFAULT_DESCRIPTION,
  current,
  image,
  imageAlt,
  breadcrumbs,
  noindex = false,
  offer = true,
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title.includes('Platonic Ideal') ? title : `${title} · Platonic Ideal`
const seoTitle = metaTitle(fullTitle)
const seoDescription = metaDescription(description)
const siteRoot = new URL('/', Astro.site)
const siteOrigin = siteRoot.origin
const socialImage = new URL(image || DEFAULT_SOCIAL_IMAGE, siteRoot).href
const socialImageAlt = imageAlt || 'Editorial portrait of Plato from the Platonic Ideal research edition.'
const organizationId = `${siteOrigin}/#organization`
const websiteId = `${siteOrigin}/#website`
const breadcrumbSchema = breadcrumbs && breadcrumbs.length >= 2
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonical.href}#breadcrumb`,
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: index === breadcrumbs.length - 1
          ? canonical.href
          : new URL(item.href || Astro.url.pathname, siteRoot).href,
      })),
    }
  : undefined
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: SITE_NAME,
      url: siteRoot.href,
      logo: {
        '@type': 'ImageObject',
        url: new URL('favicon.svg', siteRoot).href,
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: SITE_NAME,
      url: siteRoot.href,
      description: DEFAULT_DESCRIPTION,
      publisher: { '@id': organizationId },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: seoTitle,
      description: seoDescription,
      isPartOf: { '@id': websiteId },
      inLanguage: 'en-US',
      ...(breadcrumbSchema ? { breadcrumb: { '@id': breadcrumbSchema['@id'] } } : {}),
    },
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ],
}
const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, '\\u003c')
const routePath = Astro.url.pathname
const inferredCurrent = /\/account(\/|$)/.test(routePath)
  ? 'account'
  : /\/(register|collections|category)(\/|$)/.test(routePath)
    ? 'register'
    : /\/journal(\/|$)/.test(routePath)
      ? 'journal'
      : /\/search(\/|$)/.test(routePath)
        ? 'search'
        : /\/(cart|checkout|order-confirmation)(\/|$)/.test(routePath)
          ? 'cart'
          : /\/(dossier|campaign|compare)(\/|$)/.test(routePath)
            ? 'dossier'
            : /\/(methodology|constitution)(\/|$)/.test(routePath)
              ? 'methodology'
              : undefined
const resolvedCurrent = current === 'constitution' ? 'methodology' : current || inferredCurrent
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" is:inline set:html={serializedStructuredData}></script>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('PI_THEME')
          if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored
        } catch {}
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={resolvedCurrent} />
    <main id="main"><slot /></main>
    <script>
      document.querySelector('#main')?.setAttribute('tabindex', '-1')
    </script>
    {offer && <div class="shell"><DossierOffer /></div>}
    <SiteFooter />
    <div class="shop-toast" id="shop-toast" role="status" hidden></div>
    <script>import '@/scripts/analytics'</script>
    <script>import '@/scripts/commerce'</script>
  </body>
</html>

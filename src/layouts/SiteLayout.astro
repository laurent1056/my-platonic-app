---
import '@/styles/global.css'
import '@/styles/storefront.css'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import DossierOffer from '@/components/DossierOffer.astro'

interface Props {
  title?: string
  description?: string
  current?: string
  image?: string
  noindex?: boolean
  offer?: boolean
}

const {
  title = 'Platonic Ideal — One product. Or none.',
  description = 'A buyer’s guide to products that earn their place: one product worth choosing per category, or an honest explanation when none qualifies.',
  current,
  image,
  noindex = false,
  offer = true,
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title.includes('Platonic Ideal') ? title : `${title} · Platonic Ideal`
const routePath = Astro.url.pathname
const inferredCurrent = /\/(register|collections|category)(\/|$)/.test(routePath)
  ? 'register'
  : /\/journal(\/|$)/.test(routePath)
    ? 'journal'
    : /\/account(\/|$)/.test(routePath)
      ? 'account'
      : /\/search(\/|$)/.test(routePath)
        ? 'search'
        : /\/(cart|checkout|order-confirmation)(\/|$)/.test(routePath)
          ? 'cart'
          : /\/(dossier|campaign|compare)(\/|$)/.test(routePath)
            ? 'dossier'
            : /\/(methodology|constitution)(\/|$)/.test(routePath)
              ? 'methodology'
              : undefined
const resolvedCurrent = current === 'constitution' ? 'methodology' : current || inferredCurrent
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Platonic Ideal" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('PI_THEME')
          if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored
        } catch {}
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={resolvedCurrent} />
    <main id="main"><slot /></main>
    {offer && <div class="shell"><DossierOffer /></div>}
    <SiteFooter />
    <div class="shop-toast" id="shop-toast" role="status" hidden></div>
    <script>import '@/scripts/commerce'</script>
  </body>
</html>

---
import SiteLayout from '@/layouts/SiteLayout.astro'
import { register } from '@/data/register'

const oracleEntries = register.map((entry) => ({
  category: entry.category,
  status: entry.sourceStatus,
  model: entry.model,
  formDefinition: entry.formDefinition,
  coreReasoning: entry.coreReasoning,
  disqualifiers: entry.disqualifiers,
}))
---

<SiteLayout title="The Oracle" description="A private, browser-based drafting studio for applying the Platonic Ideal admission test to a category.">
  <div class="shell">
    <header class="editorial-hero">
      <p class="label">Private authoring studio</p>
      <h1 class="editorial-title">Consult the standard—not the market.</h1>
      <p class="editorial-dek">The Oracle drafts and critiques entries against the same admission test as the register. It proposes language. It never publishes, votes, or changes the canonical CSV.</p>
    </header>

    <div class="oracle-layout">
      <section class="oracle-panel" aria-labelledby="oracle-controls-title">
        <h2 class="label" id="oracle-controls-title">§ 01 · The consultation</h2>
        <form class="form-stack" id="oracle-form" style="margin-top:1.5rem">
          <div class="form-field">
            <label class="label" for="oracle-mode">Task</label>
            <select class="select-field" id="oracle-mode">
              <option value="draft">Draft a new judgment</option>
              <option value="critique">Critique the existing entry</option>
              <option value="empty">Test the case for EMPTY</option>
            </select>
          </div>
          <div class="form-field">
            <label class="label" for="oracle-category">Category</label>
            <select class="select-field" id="oracle-category">
              <option value="">Choose an existing category…</option>
              {register.map((entry) => <option value={entry.category}>{entry.category} · {entry.sourceStatus.replace(/_/g, ' ')}</option>)}
              <option value="__new__">A new category…</option>
            </select>
          </div>
          <div class="form-field" id="new-category-field" hidden>
            <label class="label" for="oracle-new-category">New category name</label>
            <input class="text-field" id="oracle-new-category" placeholder="e.g. Garden hose" />
          </div>
          <div class="form-field">
            <label class="label" for="oracle-constraints">Evidence, constraints, or challenge</label>
            <textarea class="textarea-field" id="oracle-constraints" placeholder="Name candidate models, observed failure modes, repair constraints, or the specific claim to test…"></textarea>
          </div>
          <div class="form-field">
            <label class="label" for="oracle-key">Anthropic API key</label>
            <input class="text-field" type="password" id="oracle-key" autocomplete="off" placeholder="sk-ant-…" />
            <p class="form-help">Sent directly from this browser to Anthropic. It is never included in this site or its repository.</p>
          </div>
          <label class="mono dim" style="display:flex;align-items:center;gap:.55rem;font-size:.66rem">
            <input type="checkbox" id="remember-key" /> Remember the key on this device
          </label>
          <div class="privacy-note">Browser-direct API access is appropriate for a private authoring tool, not a public multi-user feature. Use a restricted key and clear it after drafting.</div>
          <div style="display:flex;gap:.6rem;flex-wrap:wrap">
            <button class="button" type="submit">Ask the Oracle <span aria-hidden="true">◇</span></button>
            <button class="button secondary" type="button" id="clear-key">Forget key</button>
          </div>
          <p class="oracle-status" id="oracle-status" role="status" aria-live="polite"></p>
        </form>
      </section>

      <section class="oracle-panel" aria-labelledby="oracle-output-title">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem">
          <h2 class="label" id="oracle-output-title">§ 02 · Draft inscription</h2>
          <button class="button secondary" type="button" id="copy-output" hidden>Copy draft</button>
        </div>
        <div class="oracle-output" id="oracle-output" style="margin-top:1.5rem">
          <div class="oracle-placeholder">
            <div>
              <span class="gold" style="font-family:var(--serif);font-size:3rem" aria-hidden="true">◇</span>
              <p>No consultation has been made.</p>
              <p class="mono" style="font-size:.63rem">OUTPUT REMAINS OUTSIDE THE CANON<br />UNTIL EDITORIALLY REVIEWED</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</SiteLayout>

<script is:inline define:vars={{ oracleEntries }}>
  const form = document.querySelector('#oracle-form')
  const mode = document.querySelector('#oracle-mode')
  const category = document.querySelector('#oracle-category')
  const newCategoryField = document.querySelector('#new-category-field')
  const newCategory = document.querySelector('#oracle-new-category')
  const constraints = document.querySelector('#oracle-constraints')
  const keyInput = document.querySelector('#oracle-key')
  const remember = document.querySelector('#remember-key')
  const clearKey = document.querySelector('#clear-key')
  const status = document.querySelector('#oracle-status')
  const output = document.querySelector('#oracle-output')
  const copy = document.querySelector('#copy-output')

  const savedKey = localStorage.getItem('PI_ORACLE_KEY') || sessionStorage.getItem('PI_ORACLE_KEY') || ''
  if (keyInput instanceof HTMLInputElement) keyInput.value = savedKey
  if (remember instanceof HTMLInputElement) remember.checked = Boolean(localStorage.getItem('PI_ORACLE_KEY'))

  category?.addEventListener('change', () => {
    if (newCategoryField instanceof HTMLElement && category instanceof HTMLSelectElement) {
      newCategoryField.hidden = category.value !== '__new__'
    }
  })

  clearKey?.addEventListener('click', () => {
    localStorage.removeItem('PI_ORACLE_KEY')
    sessionStorage.removeItem('PI_ORACLE_KEY')
    if (keyInput instanceof HTMLInputElement) keyInput.value = ''
    if (remember instanceof HTMLInputElement) remember.checked = false
    if (status instanceof HTMLElement) status.textContent = 'Key forgotten.'
  })

  copy?.addEventListener('click', async () => {
    if (!(output instanceof HTMLElement)) return
    await navigator.clipboard.writeText(output.innerText)
    if (status instanceof HTMLElement) status.textContent = 'Draft copied to clipboard.'
  })

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!(keyInput instanceof HTMLInputElement) || !(category instanceof HTMLSelectElement)) return

    const apiKey = keyInput.value.trim()
    const categoryName = category.value === '__new__' && newCategory instanceof HTMLInputElement
      ? newCategory.value.trim()
      : category.value

    if (!apiKey || !categoryName) {
      if (status instanceof HTMLElement) status.textContent = 'Choose a category and enter an API key.'
      return
    }

    if (remember instanceof HTMLInputElement && remember.checked) {
      localStorage.setItem('PI_ORACLE_KEY', apiKey)
      sessionStorage.removeItem('PI_ORACLE_KEY')
    } else {
      sessionStorage.setItem('PI_ORACLE_KEY', apiKey)
      localStorage.removeItem('PI_ORACLE_KEY')
    }

    const existing = oracleEntries.find((entry) => entry.category === categoryName)
    const task = mode instanceof HTMLSelectElement ? mode.value : 'draft'
    const evidence = constraints instanceof HTMLTextAreaElement ? constraints.value.trim() : ''
    const context = existing
      ? `CURRENT ENTRY\nStatus: ${existing.status}\nModel: ${existing.model || '—'}\nForm: ${existing.formDefinition}\nReasoning: ${existing.coreReasoning}\nDisqualifiers: ${existing.disqualifiers}`
      : 'This is a new category with no existing entry.'

    const prompt = `You are the editorial Oracle for Platonic Ideal, a finite register that declares exactly ONE model per product category or declares the category EMPTY.

Apply these non-negotiable gates: stable Form; durable core; reversible or rational failure; stable model/parts ecosystem; and the ability to end the search. Require evidence based on construction, repair paths, production continuity, professional adoption, and observed failure mechanisms. Reject shortlists, preference-based hedging, marketing copy, and affiliate framing.

TASK: ${task}
CATEGORY: ${categoryName}
${context}
EDITORIAL EVIDENCE OR CHALLENGE: ${evidence || 'None supplied.'}

Return a concise editorial draft with these exact headings:
VERDICT
MODEL (one model only, or — if EMPTY)
FORM DEFINITION
WHY IT ENDS THE SEARCH / WHY THE SEARCH STAYS OPEN
KEY DISQUALIFIERS
ADMISSION TEST
FAILURE MODES
EVIDENCE STILL NEEDED
CONFIDENCE (1–5)

Do not pretend to have current evidence you were not given. Mark unsupported claims as requiring verification.`

    if (status instanceof HTMLElement) status.textContent = 'Consulting the standard…'
    if (output instanceof HTMLElement) output.textContent = ''
    if (copy instanceof HTMLButtonElement) copy.hidden = true

    try {
      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          'x-api-key': apiKey,
          'anthropic-version': '2023-06-01',
          'anthropic-dangerous-direct-browser-access': 'true',
        },
        body: JSON.stringify({
          model: 'claude-sonnet-5',
          max_tokens: 2500,
          messages: [{ role: 'user', content: prompt }],
        }),
      })

      const payload = await response.json()
      if (!response.ok) throw new Error(payload?.error?.message || `API request failed (${response.status})`)
      const text = Array.isArray(payload.content)
        ? payload.content.filter((block) => block.type === 'text').map((block) => block.text).join('\n')
        : ''
      if (!text) throw new Error('The Oracle returned no readable text.')

      if (output instanceof HTMLElement) output.textContent = text
      if (copy instanceof HTMLButtonElement) copy.hidden = false
      if (status instanceof HTMLElement) status.textContent = 'Draft complete. Review before editing the canon.'
    } catch (error) {
      if (output instanceof HTMLElement) output.textContent = `The consultation failed.\n\n${error instanceof Error ? error.message : 'Unknown error'}`
      if (status instanceof HTMLElement) status.textContent = 'No canonical data was changed.'
    }
  })
</script>

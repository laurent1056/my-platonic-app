---
import SiteLayout from '@/layouts/SiteLayout.astro'
import profileJson from '../../constitution/constitution.v1.json'
import { publicStateLabels } from '@/data/register'

interface Rule { id: string; key: string; title: string }
interface ConstitutionProfile {
  constitutionId: string
  version: string
  effective: string
  sourceFile: string
  digestAlgorithm: string
  sourceSha256: string
  terminalVerdicts: string[]
  workingStates: string[]
  admissionGates: Rule[]
  evidenceClasses: Rule[]
  evidenceRequirements: { minimumItems: number; minimumIndependentClasses: number }
  terminalConfidenceMinimum: number
}

const profile = profileJson as ConstitutionProfile
const digest = profile.sourceSha256
const terminalVerdicts = profile.terminalVerdicts
const workingStates = profile.workingStates
const publicStateFor = (state: string) => {
  if (state in publicStateLabels) return publicStateLabels[state as keyof typeof publicStateLabels]
  if (state === 'DRAFT') return 'Draft'
  if (state === 'UNDER_REVIEW') return 'Still researching'
  return state.replaceAll('_', ' ').toLowerCase()
}
const publicGateTitles: Record<string, string> = {
  STABLE_FORM: 'Is the category clear?',
  DURABLE_CORE: 'Does the useful part hold up?',
  REVERSIBLE_FAILURE: 'Can failure be repaired or handled rationally?',
  STABLE_MODEL: 'Will this model remain identifiable and serviceable?',
  ENDS_SEARCH: 'Does it give you one answer worth acting on?',
}
const publicEvidenceTitles: Record<string, string> = {
  MATERIALS_CONSTRUCTION: 'How it is built',
  REPAIR_PATH: 'How it can be repaired',
  PARTS_SERVICE: 'Parts and service',
  FAILURE_LONGEVITY: 'How it ages and fails',
  MODEL_STABILITY: 'Whether the model stays consistent',
  REPAIR_ECONOMICS: 'Whether repair makes sense',
  SAFETY_REGULATORY: 'Safety and applicable rules',
  MARKET_COVERAGE: 'Whether the category has been searched fairly',
}
---

<SiteLayout current="constitution" title="Our rules for making the call" description="The public rules behind every Platonic Ideal pick: one product per category, or an honest explanation when none qualifies.">
  <div class="shell constitution-page">
    <header class="constitution-hero">
      <div>
        <p class="label">Our rules · active standard</p>
        <h1 class="editorial-title">The rules behind<br /><em>every pick.</em></h1>
        <p class="editorial-dek">Anyone can call a product “best.” We show the rules that decide our answer. Every category gets one product only when it clears the same public standard. If nothing earns the answer, we explain why.</p>
      </div>
      <aside class="constitution-stamp" aria-label={`Constitution version ${profile.version}`}>
        <span class="stamp-mark" aria-hidden="true">✦</span>
        <span class="label">Active edition</span>
        <strong>v{profile.version}</strong>
        <span class="mono">effective {profile.effective}</span>
      </aside>
    </header>

    <div class="constitution-meta" aria-label="Rules at a glance">
      <div><span class="label">What stays fixed</span><strong>One standard for every category</strong></div>
      <div><span class="label">Possible final answers</span><strong>{terminalVerdicts.map(publicStateFor).join(' · ')}</strong></div>
      <div><span class="label">Current edition</span><strong>v{profile.version} · effective {profile.effective}</strong></div>
      <div><span class="label">Public record</span><strong>Evidence and changes stay visible</strong></div>
    </div>

    <div class="constitution-layout">
      <nav class="constitution-nav" aria-label="Constitution sections">
        <span class="label">Articles</span>
        <a href="#principles">01 · The promise</a>
        <a href="#admission">02 · The questions</a>
        <a href="#evidence">03 · Evidence</a>
        <a href="#states">04 · Review status</a>
        <a href="#challenges">05 · Disagreement</a>
        <a href="#independence">06 · Independence</a>
      </nav>

      <article class="constitution-copy">
        <section id="principles" class="constitution-section">
          <p class="label">Article I · The promise</p>
          <h2>One ideal per category. Or none.</h2>
          <p>Our authority does not come from popularity, volume, an opaque score, or commercial influence. It comes from applying the same public rules to every case, showing the evidence, admitting uncertainty, and correcting the record without quietly erasing the past.</p>
          <div class="principle-list">
            <div><span class="mono">01</span><strong>One answer per category</strong><p>One product is named when it earns the standard. No ties or preference matrices that send the decision back to you.</p></div>
            <div><span class="mono">02</span><strong>Useful clarity over endless optimization</strong><p>The point is to end a reasonable search, not create another comparison spiral. A pick must be defensible, not mythical.</p></div>
            <div><span class="mono">03</span><strong>Reversible failure</strong><p>Expected failure must be repairable, rebuildable, maintainable, or rationally renewable.</p></div>
            <div><span class="mono">04</span><strong>No pick is a last resort</strong><p>We clarify the job, separate different uses, and test repair and renewal before saying that no product qualifies.</p></div>
            <div><span class="mono">05</span><strong>Updates are public</strong><p>No ruling disappears silently. Confirmations, changes, and removals remain part of the record.</p></div>
          </div>
        </section>

        <section id="admission" class="constitution-section">
          <p class="label">Article III · The questions</p>
          <h2>Five questions every product must answer.</h2>
          <p>An unanswered question is not a pass. Every final pick must clear all five questions, regardless of popularity, price, or review scores.</p>
          <ol class="gate-list">
            {profile.admissionGates.map((gate) => <li><span class="gate-id mono">{gate.id}</span><div><strong title={gate.title}>{publicGateTitles[gate.key] ?? gate.title}</strong><p>We must answer this question in the case file and support the answer with evidence.</p></div></li>)}
          </ol>
        </section>

        <section id="evidence" class="constitution-section">
          <p class="label">Article IV · Evidence standard</p>
          <h2>Show us how it lasts.</h2>
          <div class="rule-callout">
            <strong>{profile.evidenceRequirements.minimumItems} pieces of evidence · {profile.evidenceRequirements.minimumIndependentClasses} independent source types</strong>
            <span>At least one primary technical or service source and one independent source.</span>
          </div>
          <div class="evidence-list">
            {profile.evidenceClasses.map((item) => <div><span class="mono">{item.id}</span><strong title={item.title}>{publicEvidenceTitles[item.key] ?? item.title}</strong><span>Evidence we look for in this category.</span></div>)}
          </div>
          <p class="constitution-note">Three pages repeating one press release are one source, not three. We keep facts, our inferences, and unanswered questions distinct.</p>
        </section>

        <section id="states" class="constitution-section">
          <p class="label">Article VI · Review status</p>
          <h2>Final picks are earned.</h2>
          <div class="state-columns">
            <div class="state-card terminal"><span class="label">Final decisions</span>{terminalVerdicts.map((state) => <strong title={state}>{publicStateFor(state)}</strong>)}<p>A public conclusion that has crossed the evidence floor.</p></div>
            <div class="state-card working"><span class="label">Still in progress</span><div class="state-tags">{workingStates.map((state) => <code title={state}>{publicStateFor(state)}</code>)}</div><p>Useful research statuses that are not recommendations.</p></div>
          </div>
          <p>Evidence strength describes the completeness and resilience of a case, not product quality or enthusiasm. No final decision may be issued below <strong>{profile.terminalConfidenceMinimum}/5</strong>.</p>
        </section>

        <section id="challenges" class="constitution-section">
          <p class="label">Article IX · Disagreement</p>
          <h2>If you disagree, show us the claim.</h2>
          <p>A useful challenge names the specific question, product claim, source, or change in the model that should be reconsidered. It states an objection someone else can check and supplies verifiable evidence.</p>
          <p class="constitution-note">This is not a voting system. Popularity, brand preference, a competing nomination, disagreement without evidence, or payment does not change a verdict.</p>
        </section>

        <section id="independence" class="constitution-section">
          <p class="label">Articles XI–XII · Boundaries</p>
          <h2>Independent by design. Accountable in public.</h2>
          <p>The rules and complete public decision remain free. A future paid guide may sell convenience and depth, never a different verdict or hidden decisive reasoning. The private Oracle may draft and critique; it cannot create evidence or publish a decision on its own.</p>
          <div class="boundary-line"><span class="label">No paid verdicts</span><span class="boundary-dot" aria-hidden="true">·</span><span class="label">No automatic publication</span></div>
          <details class="constitution-technical">
            <summary>Technical record</summary>
            <div><span class="label">Source file</span><code>{profile.sourceFile}</code></div>
            <div><span class="label">Source digest</span><code title={digest}>{digest.slice(0, 16)}…</code></div>
            <div><span class="label">Digest algorithm</span><code>{profile.digestAlgorithm.toUpperCase()}</code></div>
            <div><span class="label">Constitution ID</span><code>{profile.constitutionId}</code></div>
          </details>
        </section>
      </article>
    </div>
  </div>
</SiteLayout>

<style>
  .constitution-page { padding: clamp(3.4rem, 7vw, 6.5rem) 0 6rem; }
  .constitution-hero { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 2rem; align-items: end; padding-bottom: clamp(2.5rem, 6vw, 5rem); border-bottom: 1px solid var(--line-strong); }
  .constitution-hero .editorial-title { margin-top: .85rem; }
  .constitution-hero .editorial-title em { color: var(--accent); font-style: normal; }
  .constitution-stamp { display: grid; gap: .35rem; justify-items: start; padding: 1.25rem; border: 1px solid var(--line-strong); background: var(--surface); box-shadow: 5px 5px 0 var(--gold); }
  .stamp-mark { color: var(--gold); font-size: 1.2rem; }
  .constitution-stamp strong { font-family: var(--serif); font-size: 2.3rem; font-weight: 500; line-height: 1; }
  .constitution-stamp .mono { color: var(--muted); font-size: .65rem; }
  .constitution-meta { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); }
  .constitution-meta > div { display: grid; gap: .4rem; min-height: 88px; padding: 1rem .9rem; border-right: 1px solid var(--line); }
  .constitution-meta > div:first-child { border-left: 1px solid var(--line); }
  .constitution-meta strong, .constitution-meta code { font-family: var(--mono); font-size: .72rem; font-weight: 500; line-height: 1.45; }
  .constitution-meta code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .constitution-layout { display: grid; grid-template-columns: 180px minmax(0, 680px); gap: clamp(2rem, 7vw, 7rem); justify-content: center; padding-top: clamp(3rem, 7vw, 6rem); }
  .constitution-nav { position: sticky; top: 1.5rem; align-self: start; display: grid; gap: .1rem; }
  .constitution-nav .label { margin-bottom: .7rem; }
  .constitution-nav a { padding: .35rem 0; color: var(--muted); font-family: var(--mono); font-size: .66rem; }
  .constitution-nav a:hover { color: var(--accent); }
  .constitution-copy { min-width: 0; }
  .constitution-section { padding-bottom: clamp(3rem, 6vw, 5rem); margin-bottom: clamp(3rem, 6vw, 5rem); border-bottom: 1px solid var(--line); scroll-margin-top: 2rem; }
  .constitution-section:last-child { margin-bottom: 0; }
  .constitution-section h2 { max-width: 620px; margin: .65rem 0 1rem; font-family: var(--serif); font-size: clamp(2.5rem, 5vw, 4.2rem); font-weight: 500; letter-spacing: -.035em; line-height: .95; }
  .constitution-section > p:not(.label) { max-width: 620px; color: var(--ink-soft); }
  .principle-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.35rem 2rem; margin-top: 2.25rem; }
  .principle-list > div { display: grid; grid-template-columns: 2rem 1fr; gap: .15rem .6rem; padding-top: .7rem; border-top: 1px solid var(--line-strong); }
  .principle-list .mono { color: var(--accent); font-size: .7rem; }
  .principle-list strong { font-family: var(--caps); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .principle-list p { grid-column: 2; margin: .2rem 0 0; color: var(--muted); font-size: .84rem; line-height: 1.5; }
  .gate-list { display: grid; gap: 0; margin: 2rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .gate-list li { display: grid; grid-template-columns: 4rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .gate-id { color: var(--accent); font-size: .7rem; padding-top: .15rem; }
  .gate-list strong { font-family: var(--caps); font-size: .76rem; letter-spacing: .09em; text-transform: uppercase; }
  .gate-list p { margin: .25rem 0 0; color: var(--muted); font-size: .88rem; }
  .rule-callout { display: grid; gap: .25rem; margin: 2rem 0; padding: 1rem 1.2rem; border-left: 3px solid var(--gold); background: var(--surface); }
  .rule-callout strong { font-family: var(--caps); font-size: .73rem; letter-spacing: .1em; text-transform: uppercase; }
  .rule-callout span { color: var(--muted); font-size: .86rem; }
  .evidence-list { display: grid; gap: 0; border-top: 1px solid var(--line-strong); }
  .evidence-list > div { display: grid; grid-template-columns: 3.5rem 1fr auto; align-items: baseline; gap: .8rem; padding: .7rem 0; border-bottom: 1px solid var(--line); }
  .evidence-list .mono { color: var(--accent); font-size: .68rem; }
  .evidence-list strong { font-family: var(--caps); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
  .evidence-list span:last-child { color: var(--muted); font-size: .75rem; }
  .constitution-note { margin-top: 1.5rem; padding-left: 1rem; border-left: 1px solid var(--accent); color: var(--muted) !important; font-size: .84rem; }
  .state-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0 1.5rem; }
  .state-card { display: grid; gap: .65rem; min-height: 180px; padding: 1.2rem; border: 1px solid var(--line-strong); background: var(--surface); }
  .state-card.terminal { border-top: 3px solid var(--gold); }
  .state-card.terminal strong { font-family: var(--serif); font-size: 2rem; font-weight: 500; line-height: 1; }
  .state-card.working { border-top: 3px solid var(--accent); }
  .state-card p { align-self: end; margin: 0; color: var(--muted); font-size: .82rem; }
  .state-tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  .state-tags code { padding: .28rem .4rem; border: 1px solid var(--line); color: var(--muted); font-family: var(--mono); font-size: .62rem; }
  .boundary-line { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line-strong); }
  .boundary-line code { color: var(--accent); font-family: var(--mono); font-size: .68rem; }
  .boundary-dot { color: var(--gold); }
  .constitution-technical { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  .constitution-technical summary { padding: .9rem 0; cursor: pointer; color: var(--muted); font-family: var(--caps); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; }
  .constitution-technical > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .7rem; padding: .6rem 0; border-top: 1px solid var(--line); }
  .constitution-technical code { color: var(--accent); font-family: var(--mono); font-size: .68rem; }
  @media (max-width: 760px) {
    .constitution-hero { grid-template-columns: 1fr; }
    .constitution-stamp { width: min(220px, 100%); }
    .constitution-meta { grid-template-columns: repeat(2, 1fr); }
    .constitution-meta > div:nth-child(3) { border-left: 1px solid var(--line); }
    .constitution-layout { display: block; }
    .constitution-nav { position: static; display: flex; flex-wrap: wrap; gap: .2rem .9rem; margin-bottom: 3rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line-strong); }
    .constitution-nav .label { width: 100%; }
  }
  @media (max-width: 520px) {
    .principle-list, .state-columns { grid-template-columns: 1fr; }
    .evidence-list > div { grid-template-columns: 3.5rem 1fr; }
    .evidence-list span:last-child { grid-column: 2; }
  }
</style>

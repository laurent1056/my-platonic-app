---
import SiteLayout from '@/layouts/SiteLayout.astro'
import { dossier } from '@/data/dossier'
import { withBase } from '@/data/register'
---
<SiteLayout title="Checkout preview" noindex offer={false}><div class="shell page-space"><nav class="breadcrumbs" aria-label="Checkout progress"><a href={withBase('cart/')}>01 Cart</a><span>→</span><span aria-current="step">02 Checkout</span><span>→</span><span>03 Confirmation</span></nav><div class="page-heading"><p class="eyebrow">Digital edition</p><h1>A more considered purchase.</h1><p>This is a checkout preview. No payment is taken and no personal information is needed.</p></div><div class="empty-state" data-cart-empty><h2>Your cart is empty.</h2><p>Add the dossier to explore checkout.</p><a class="button" href={withBase('dossier/')}>Get the dossier · {dossier.priceLabel} →</a></div><div class="transaction-grid" data-cart-filled hidden><div class="checkout-sections"><section><span class="eyebrow">01 · Delivery</span><h2>A digital reading experience.</h2><label class="form-field"><span>Delivery email · illustrative only</span><input type="email" value="reader@example.com" disabled /></label><p class="fine-print">Email delivery and the final file format will be confirmed before sales open.</p></section><section><span class="eyebrow">02 · Payment</span><h2>One payment. No subscription.</h2><div class="payment-placeholder"><span>Payment provider</span><span>Not connected</span></div><p>Live checkout will show applicable taxes and the final total before you pay. Card details are never collected in this preview.</p></section><section><span class="eyebrow">03 · Review</span><p>You are previewing a digital research dossier. The objects in the catalog are not included.</p><a class="inline-link" href={withBase('shipping-returns/')}>Delivery & returns information ↗</a></section></div><aside class="order-summary"><p class="eyebrow">Your order</p><h2>{dossier.name}</h2><p>Digital edition · Quantity 1</p><dl><div><dt>Proposed price</dt><dd>{dossier.priceLabel}</dd></div><div><dt>Charged today</dt><dd>$0</dd></div></dl><button class="button wide-button" data-complete-preview type="button">Complete preview · No charge →</button><p class="fine-print">Creates a local preview record only. No real order, account, receipt, or download is created.</p></aside></div></div></SiteLayout>

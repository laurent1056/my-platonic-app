---
import SiteLayout from '@/layouts/SiteLayout.astro'
import DossierCover from '@/components/DossierCover.astro'
import { dossier } from '@/data/dossier'
import { withBase } from '@/data/register'
---
<SiteLayout title="Your cart" noindex offer={false}><div class="shell page-space"><div class="page-heading"><p class="eyebrow">01 / Cart</p><h1>Your cart.</h1><p>One considered purchase. A digital dossier to return to.</p></div><p class="preview-note">Sandbox purchase flow. No physical products, payments, or paid downloads.</p><div class="empty-state" data-cart-empty><h2>A little room for better judgment.</h2><p>Your cart is empty. Start with a sample of the dossier.</p><a class="button" data-analytics-event="dossier_cta_click" href={withBase('dossier/')}>Explore the dossier · {dossier.priceLabel} ↗</a></div><div class="transaction-grid" data-cart-filled hidden><div class="cart-line"><div class="cart-cover"><DossierCover compact /></div><div><p class="eyebrow">Digital edition</p><h2>{dossier.name}</h2><p>One digital copy · One-time purchase</p><button type="button" class="text-button" data-remove-dossier>Remove</button></div><strong class="mono">{dossier.priceLabel}</strong></div><aside class="order-summary"><h2>Order summary</h2><dl><div><dt>The dossier × 1</dt><dd>{dossier.priceLabel}</dd></div><div><dt>Physical shipping</dt><dd>Not applicable</dd></div><div><dt>Tax</dt><dd>Not calculated in sandbox</dd></div><div class="total"><dt>Sandbox subtotal</dt><dd>{dossier.priceLabel}</dd></div></dl><a class="button wide-button" data-analytics-event="preview_checkout_start" data-analytics-mode="preview" href={withBase('checkout/')}>Preview checkout →</a><p class="fine-print">Nothing will be charged. Live purchasing is not enabled.</p><a class="inline-link" href={withBase('dossier/#sample')}>Keep reading the sample</a></aside></div></div></SiteLayout>

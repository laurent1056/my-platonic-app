---
import SiteLayout from '@/layouts/SiteLayout.astro'
import { withBase } from '@/data/register'
---

<SiteLayout title="Page not found" description="This page is not in the Platonic Ideal product catalog.">
  <div class="shell">
    <section class="editorial-hero" style="min-height:65vh">
      <p class="label oxide">404 · Page not found</p>
      <h1 class="editorial-title">That page isn’t in the catalog.</h1>
      <p class="editorial-dek">This is a missing link, not a verdict on the category. Go back to the catalog to find the product or category you were looking for.</p>
      <a class="button" href={withBase('register/')} style="margin-top:2rem">Explore products</a>
    </section>
  </div>
</SiteLayout>

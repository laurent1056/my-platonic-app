---
import SiteLayout from '@/layouts/SiteLayout.astro'
import StatusChip from '@/components/StatusChip.astro'
import ConfidenceMeter from '@/components/ConfidenceMeter.astro'
import ProductPlate from '@/components/ProductPlate.astro'
import SourceReference from '@/components/SourceReference.astro'
import { approvedPlateFor } from '@/data/product-plates'
import { categoryUrl, publicPermanenceDescriptions, publicPermanenceLabels, publicStateLabel, register, splitStatements, withBase, type RegisterEntry } from '@/data/register'

export function getStaticPaths() {
  return register.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))
}

interface Props { entry: RegisterEntry }
const { entry } = Astro.props
const index = register.findIndex((candidate) => candidate.slug === entry.slug)
const next = register[(index + 1) % register.length]
const isDeclared = entry.verdict === 'DECLARED'
const isEmpty = entry.verdict === 'EMPTY'
const declaration = isDeclared ? entry.model : isEmpty ? 'No product qualifies.' : 'Declaration withheld.'
const description = entry.summary || entry.coreReasoning || `${entry.category}: ${declaration}`
const approvedPlate = approvedPlateFor(entry.reference)
const disqualifiers = splitStatements(entry.disqualifiers)
const admission = splitStatements(entry.admissionTest)
const failures = splitStatements(entry.failureModes)
---

<SiteLayout title={`${entry.category} — ${declaration}`} description={description} image={approvedPlate ? withBase(approvedPlate.path) : undefined}>
  <div class="shell">
    <section class="dossier-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('register/')}>Explore products</a><span aria-hidden="true">/</span><span>{entry.category}</span>
      </nav>
      <div class="dossier-title-row">
        <div>
          <StatusChip verdict={entry.verdict} sourceStatus={entry.sourceStatus} />
          <h1 class="dossier-title">{entry.category}</h1>
        </div>
        <div class="dossier-reference">
          <span class="label">Category</span><br />
          {entry.number} of {register.length}
        </div>
      </div>
    </section>

    <div class="dossier-grid">
      <aside class="specimen-panel" aria-label="Product illustration and buying details">
        <div class:list={['specimen-stage', { empty: isEmpty }]}>
          {isDeclared && <span class="nimbus" aria-hidden="true"></span>}
          {isEmpty ? (
            <p class="absence-mark">No qualifying product yet.</p>
          ) : (
            <ProductPlate entry={entry} />
          )}
        </div>
        <dl class="specimen-meta">
          <div><dt class="label">Typical price</dt><dd>{entry.price || '—'}</dd></div>
          <div><dt class="label" title="How complete and resilient the evidence is—not a product score.">Evidence strength</dt><dd><ConfidenceMeter value={entry.confidence} /></dd></div>
          <div><dt class="label" title={publicPermanenceDescriptions[entry.permanenceKind]}>Why it lasts</dt><dd>{publicPermanenceLabels[entry.permanenceKind]}</dd></div>
          <div><dt class="label">Last reviewed</dt><dd>{entry.lastReviewed || '—'}</dd></div>
        </dl>
        {isDeclared && <SourceReference productId={entry.reference} />}
      </aside>

      <article>
        <header class:list={['model-declaration', { empty: !isDeclared }]}>
          <p class="label">{isDeclared ? 'Our pick' : isEmpty ? 'No qualifying pick' : publicStateLabel(entry.verdict, entry.sourceStatus)}</p>
          <h2 class:list={['model-name', { empty: !isDeclared }]}>{isDeclared ? declaration : isEmpty ? 'No product has earned the pick yet.' : 'Research is still in progress.'}</h2>
          {isDeclared && entry.price && <p class="mono dim" style="margin:.8rem 0 0">Typical price · {entry.price}</p>}
        </header>

        <p class="dossier-lede">{entry.summary || entry.formDefinition}</p>

        {entry.formDefinition && (
          <section class="argument">
            <h2>What we were looking for</h2>
            <p>{entry.formDefinition}</p>
          </section>
        )}

        {entry.coreReasoning && (
          <section class="argument">
            <h2>{isDeclared ? 'Why this is our pick' : isEmpty ? 'Why no product has earned the pick' : 'Why the decision is still open'}</h2>
            <p class="versal">{entry.coreReasoning}</p>
          </section>
        )}

        {disqualifiers.length > 0 && (
          <section class="argument">
            <h2>{isDeclared ? 'Why other products fell short' : 'What prevents a clear pick'}</h2>
            <ul class="evidence-list">
              {disqualifiers.map((statement) => <li>{statement}</li>)}
            </ul>
          </section>
        )}

        {admission.length > 0 && (
          <section class="argument">
            <h2>{isEmpty ? 'What a future product would need' : 'What a qualifying product must do'}</h2>
            <ul class:list={['evidence-list', { 'requirement-list': isEmpty || !isDeclared }]}>
              {admission.map((statement) => <li>{statement}</li>)}
            </ul>
          </section>
        )}

        {failures.length > 0 && (
          <section class="argument">
            <h2>What can go wrong</h2>
            <ul class="evidence-list">
              {failures.map((statement) => <li>{statement}</li>)}
            </ul>
          </section>
        )}

        <dl class="dossier-facts">
          <div class="fact"><dt class="label" title="What wears out, needs care, or may eventually need replacement.">What you’ll maintain</dt><dd>{entry.maintenance || 'Not recorded'}</dd></div>
          <div class="fact"><dt class="label" title={publicPermanenceDescriptions[entry.permanenceKind]}>Why it lasts</dt><dd>{entry.permanence || 'Not recorded'}</dd></div>
          <div class="fact"><dt class="label" title="Products we reviewed but did not choose.">Other products considered</dt><dd>{entry.alternates || 'None recorded'}</dd></div>
          <div class="fact"><dt class="label">Review status</dt><dd>{publicStateLabel(entry.verdict, entry.sourceStatus)}</dd></div>
        </dl>
      </article>
    </div>

    <a class="next-entry" href={categoryUrl(next)}>
      <span><span class="label">Next category</span><strong>{next.category}</strong></span>
      <span class="mono" aria-hidden="true">→</span>
    </a>
  </div>
</SiteLayout>

---
import SiteLayout from '@/layouts/SiteLayout.astro'
import DossierCover from '@/components/DossierCover.astro'
import CategoryCard from '@/components/CategoryCard.astro'
import { dossier, dossierChapters } from '@/data/dossier'
import { domains, register, registerStats, withBase } from '@/data/register'
const featured = ['frying-pan', 'pocket-knife', 'pen', 'boots'].map(slug => register.find(entry => entry.slug === slug)!)
---
<SiteLayout current="index" title="Platonic Ideal — Fewer things. Better reasons.">
  <div class="shell">
    <section class="store-hero" aria-labelledby="home-heading">
      <div class="store-hero-copy"><p class="eyebrow"><span class="small-rule"></span> A more considered way to buy</p><h1 id="home-heading">Fewer things.<br /><em>Better reasons.</em></h1><p class="store-dek">A world of products. One independent standard. Find the objects worth choosing—and the research that helps you choose with conviction.</p><div class="action-row"><a class="button" href={withBase('dossier/')}>Get the dossier <span>{dossier.priceLabel} ↗</span></a><a class="inline-link" href={withBase('register/')}>Explore the free catalog →</a></div><p class="hero-footnote">Our only product is the research.<br />The verdicts will always be free.</p></div>
      <div class="hero-book-stage"><span class="book-stage-caption eyebrow">The digital research edition</span><DossierCover href={withBase('dossier/')} eager /><span class="book-stage-bottom"><span>One dossier. A clearer point of view.</span><span aria-hidden="true">↗</span></span></div>
    </section>
    <div class="principle-strip"><span><b>{registerStats.total}</b> categories in the catalog</span><span>One pick. Or an honest no.</span><span>Evidence before verdict</span><span>Independent by design</span></div>
    <section class="store-section"><div class="store-section-heading"><div><p class="eyebrow">The public catalog</p><h2>Everyday objects. Examined.</h2></div><a class="inline-link" href={withBase('register/')}>Explore all categories ↗</a></div><div class="collection-pills">{domains.slice(0, 5).map(domain => <a href={withBase(`collections/${domain.id}/`)}>{domain.name} <span>↗</span></a>)}</div><div class="category-grid featured-grid">{featured.map(entry => <CategoryCard entry={entry} />)}</div><p class="fine-print">Editorial illustrations are interpretive plates, not product photography. Physical products are not sold here.</p></section>
    <section class="inside-section"><div><p class="eyebrow">Inside the dossier</p><h2>The research you can<br /><em>come back to.</em></h2><p>A considered companion to the public catalog. The dossier brings the deeper reading, tradeoffs, and ownership questions into one place.</p><a class="inline-link" href={withBase('dossier/#sample')}>Read a sample →</a></div><div class="chapter-list">{dossierChapters.map(([number, title, copy]) => <div><span class="chapter-number">{number}</span><section><h3>{title}</h3><p>{copy}</p></section></div>)}</div></section>
    <section class="editorial-note"><p class="eyebrow">Our conviction</p><blockquote>“The right answer can be<br /><em>nothing at all.</em>”</blockquote><p>When no product meets the standard, we say so. You can read that judgment for free. Paying for the dossier never changes it.</p><a class="inline-link" href={withBase('methodology/')}>How we choose ↗</a></section>
  </div>
</SiteLayout>

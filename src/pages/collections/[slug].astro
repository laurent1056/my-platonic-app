---
import SiteLayout from '@/layouts/SiteLayout.astro'
import Catalog from '@/components/Catalog.astro'
import { domains, withBase, type DomainDefinition } from '@/data/register'
export function getStaticPaths() { return domains.map(domain => ({ params: { slug: domain.id }, props: { domain } })) }
interface Props { domain: DomainDefinition }
const { domain } = Astro.props
---
<SiteLayout title={domain.name} current="register" description={`${domain.description} Browse independent research on products built for useful, repairable ownership.`} breadcrumbs={[{ name: 'Home', href: withBase() }, { name: 'The catalog', href: withBase('register/') }, { name: domain.name }]}><div class="shell page-space"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={withBase('register/')}>The catalog</a><span>/</span><span>{domain.name}</span></nav><div class="page-heading"><p class="eyebrow">Collection</p><h1>{domain.name}.</h1><p>{domain.description} Read the public verdicts; our only paid product is the dossier.</p></div><Catalog domain={domain.id} /></div></SiteLayout>

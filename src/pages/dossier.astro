---
import SiteLayout from '@/layouts/SiteLayout.astro'
import DossierCover from '@/components/DossierCover.astro'
import { dossier, dossierChapters, getDossierFaqs } from '@/data/dossier'
import { getLivePaymentLink } from '@/lib/payment-link'
import { withBase } from '@/data/register'
const paymentLink = getLivePaymentLink(import.meta.env.PUBLIC_STRIPE_PAYMENT_LINK_URL)
const dossierFaqs = getDossierFaqs(Boolean(paymentLink))
---
<SiteLayout title="The dossier — 48 recommendations · $24" current="dossier" description="The Platonic Ideal Declared Edition is a 157-page tagged PDF containing 48 product recommendations, with the evidence, tradeoffs, and ownership reasoning behind each one." image={withBase('images/platonic-ideal-dossier-cover.jpg')} imageAlt="The Platonic Ideal Dossier cover with a portrait of Plato and a red circular motif." breadcrumbs={[{ name: 'Home', href: withBase() }, { name: 'The dossier' }]} offer={false}>
  <div class="shell page-space">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={withBase()}>Home</a><span>/</span><span>The dossier</span></nav>
    <section class="product-detail" data-dossier-edition={dossier.editionId} data-dossier-id={dossier.id} data-dossier-name={dossier.name} data-dossier-price={dossier.price} data-dossier-currency="USD">
      <div class="product-art"><DossierCover eager /><p class="fine-print">Digital edition · Plato-led cover concept</p></div>
      <div class="product-info"><p class="eyebrow">Our one and only product</p><h1>The Platonic<br />Ideal <em>Dossier.</em></h1><p class="product-description">Spend less time comparing. Spend more time understanding what makes something worth owning.</p><div class="product-price"><strong>{dossier.priceLabel}</strong><span>One-time purchase<br />{dossier.format}</span></div><p>Our public catalog gives you the verdict. The dossier is the deeper companion: organized research, context for the tradeoffs, and a considered approach to ownership.</p><ul class="check-list"><li>{dossier.recommendationCount} declared recommendations</li><li>{dossier.pageCount} pages of evidence, tradeoffs, and ownership notes</li><li>The same independent standard as the free catalog</li></ul>{paymentLink ? <a class="button wide-button" data-analytics-event="checkout_start" data-analytics-item-id={dossier.id} data-analytics-item-name={dossier.name} data-analytics-item-category="digital_dossier" data-analytics-item-price={dossier.price} data-analytics-item-list-name="dossier_detail" data-analytics-value={dossier.price} data-analytics-currency="USD" data-analytics-edition-id={dossier.editionId} href={paymentLink} rel="external">Buy the declared edition <span>{dossier.priceLabel} ↗</span></a> : <p class="preview-note" id="purchase-status">Stripe checkout is not configured in this build yet. The purchase link will appear here when the production payment configuration is present.</p>}<div class="product-secondary"><a class="inline-link" href="#sample">Read a sample</a></div><p class="fine-print">Stripe hosts checkout. After payment is confirmed, the digital edition is available through the purchase confirmation flow.</p><div class="product-links"><a href={withBase('compare/')}>What stays free ↗</a><a href={withBase('shipping-returns/')}>Delivery & returns ↗</a></div></div>
    </section>
    <nav class="detail-tabs" aria-label="Dossier information"><a href="#contents">What's inside</a><a href="#sample">Read a sample</a><a href="#questions">Questions</a></nav>
    <section class="inside-section" id="contents"><div><p class="eyebrow">Inside the Declared Edition</p><h2>From a question<br /><em>to a considered choice.</em></h2><p>A reading experience built around the decisions that matter, rather than an endless list of products. The edition contains {dossier.recommendationCount} declared recommendations across {dossier.pageCount} pages.</p></div><div class="chapter-list">{dossierChapters.map(([n, title, copy]) => <div><span class="chapter-number">{n}</span><section><h3>{title}</h3><p>{copy}</p></section></div>)}</div></section>
    <section class="sample-section" id="sample"><div><p class="eyebrow">An editorial sample · The standard</p><h2>Start with the job.<br /><em>Then consider the object.</em></h2><p>Before asking which product is best, define what it needs to do. A category as broad as “chair” hides different jobs: focused work, dining, resting. A useful judgment begins with a bounded question.</p><p>Next, ask what would make the object stop serving that job. Does the material wear? Can the worn part be replaced? Does a software service have to remain available? An ownership decision extends beyond the day of purchase.</p><p>Finally, leave room for an empty answer. If the evidence does not support a qualifying product, a longer shortlist does not resolve the uncertainty. A clear explanation of what is missing is a useful result.</p><div class="action-row"><a class="button secondary" data-analytics-event="dossier_sample_open" data-analytics-download-type="sample" data-analytics-access-type="public" data-analytics-trial="true" data-analytics-file-name="platonic-ideal-dossier-sample.pdf" data-analytics-file-extension="pdf" data-analytics-edition-id={dossier.editionId} href={withBase('dossier/platonic-ideal-dossier-sample.pdf')} target="_blank" rel="noopener">Open the sample PDF ↗</a><a class="inline-link" href={withBase('methodology/')}>Read our complete public methodology →</a></div></div><aside><span class="eyebrow">A question to keep</span><blockquote>What has to remain true for this object to keep doing its job?</blockquote><p class="fine-print">Illustrative reading sample. The public reasoning remains accessible without a purchase.</p></aside></section>
    <section class="faq-section" id="questions"><div class="store-section-heading"><h2>A few good questions.</h2><a class="inline-link" href={withBase('help/')}>Visit the help center ↗</a></div>{dossierFaqs.slice(0, 5).map(([q, a]) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</section>
  </div>
</SiteLayout>

---
import { dossier } from '@/data/dossier'
import { withBase } from '@/data/register'

interface Props {
  compact?: boolean
  eager?: boolean
  href?: string
}

const { compact = false, eager = false, href } = Astro.props
const coverSrc = withBase('images/platonic-ideal-dossier-cover.jpg')
---
<figure class:list={['dossier-object', { compact }]}>
  <div class="dossier-cover dossier-cover-image">
    <img
      class="dossier-cover-art"
      src={coverSrc}
      width="1600"
      height="2560"
      alt="The Platonic Ideal Dossier cover: a cream book cover with a red circular motif and a portrait of Plato"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
    {href && <a class="dossier-cover-link" href={href} data-analytics-event="dossier_cta_click" data-analytics-item-id={dossier.id} data-analytics-item-name={dossier.name} data-analytics-item-category="digital_dossier" data-analytics-item-price={dossier.price} data-analytics-item-list-name="cover" data-analytics-value={dossier.price} data-analytics-currency="USD" data-analytics-edition-id={dossier.editionId}><span class="sr-only">Explore the Platonic Ideal Dossier</span></a>}
  </div>
</figure>

---
import { registerStats, withBase } from '@/data/register'
const groups = [
  ['Explore', [['The catalog', 'register/'], ['The dossier', 'dossier/'], ['Journal', 'journal/'], ['About us', 'about/']]],
  ['Our standard', [['How we choose', 'methodology/'], ['The Constitution', 'constitution/'], ['Free vs. paid', 'compare/'], ['Brands & independence', 'brands/']]],
  ['Reader support', [['Help center', 'help/'], ['Contact', 'contact/'], ['Digital delivery & returns', 'shipping-returns/']]],
] as const
---
<footer class="shop-footer">
  <div class="shell">
    <div class="shop-footer-grid">
      <div><a class="footer-wordmark" href={withBase()}>Platonic Ideal</a><p>Fewer things.<br />Better reasons.</p><span class="fine-print">{registerStats.total} categories. One independent standard.</span></div>
      {groups.map(([title, links]) => <nav aria-label={title}><h2 class="eyebrow">{title}</h2>{links.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}</nav>)}
    </div>
    <div class="shop-colophon"><span>© {new Date().getFullYear()} Platonic Ideal</span><div><a href={withBase('privacy/')}>Privacy</a><a href={withBase('terms/')}>Terms</a><a href={withBase('page-directory/')}>Page directory</a></div><span>Evidence before verdict.</span></div>
  </div>
</footer>

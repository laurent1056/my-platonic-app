---
import { accountPages } from '@/data/site-pages'
import { dossier } from '@/data/dossier'
import { withBase } from '@/data/register'
import DossierCover from './DossierCover.astro'
interface Props { slug: string }
const { slug } = Astro.props
---
<div class="account-layout">
  <nav class="account-nav" aria-label="Account navigation">{accountPages.filter(([path]) => path !== 'account/orders/preview').map(([path, , label]) => <a href={withBase(`${path}/`)} aria-current={slug === path ? 'page' : undefined}>{label}<span aria-hidden="true">↗</span></a>)}<a href={withBase('account/login/')}>Login preview →</a></nav>
  <div class="account-content"><p class="preview-note">Account design preview. No sign-in or real purchase history. Cart and saved-item choices stay on this device.</p>
  {slug === 'account' && <><div class="account-welcome"><p class="eyebrow">Your library</p><h2>A place for your research.</h2><p>The dossier will live here when purchasing and reader access are available. For now, explore the sample or continue your research in the free catalog.</p><div class="action-row"><a class="button" href={withBase('dossier/#sample')}>Read the dossier sample →</a><a class="inline-link" href={withBase('register/')}>Explore the catalog</a></div></div><div class="account-links"><a href={withBase('account/orders/')}><h3>Order history</h3><p>Review your local checkout preview.</p><span>View history →</span></a><a href={withBase('account/wishlist/')}><h3>Saved for later</h3><p>Return to the dossier when you're ready.</p><span>View saved items →</span></a></div></>}
  {(slug === 'account/orders' || slug === 'account/orders/preview') && <><div data-order-empty class="empty-state"><h2>No preview records yet.</h2><p>Try the dossier checkout to see how a purchase could appear here.</p><a class="button" href={withBase('dossier/')}>Explore the dossier · {dossier.priceLabel} →</a></div><div data-order-filled hidden><p class="eyebrow">Local preview · Not a real order</p><div class="receipt-line"><strong>PI-PREVIEW</strong><span>$0 charged</span></div><h2>{dossier.name}</h2><p>No payment, email, or paid download was created.</p><dl class="account-facts"><div><dt>Status</dt><dd>Preview completed</dd></div><div><dt>Format</dt><dd>Digital dossier concept</dd></div><div><dt>Quantity</dt><dd>1</dd></div><div><dt>Access</dt><dd>Public sample only</dd></div></dl><a class="button secondary" href={withBase(slug === 'account/orders' ? 'account/orders/preview/' : 'dossier/#sample')}>{slug === 'account/orders' ? 'View preview details →' : 'Read the sample →'}</a></div></>}
  {slug === 'account/wishlist' && <><div data-saved-empty class="empty-state"><h2>Nothing saved. Yet.</h2><p>Save the dossier from its product page to return to it here.</p><a class="button" href={withBase('dossier/')}>Explore the dossier →</a></div><div data-saved-filled hidden class="saved-dossier"><div class="cart-cover"><DossierCover compact /></div><div><p class="eyebrow">Saved on this device</p><h2>{dossier.name}</h2><p>{dossier.priceLabel} · Digital edition · One-time purchase</p><div class="action-row"><button class="button" data-add-dossier type="button">Add the dossier to cart →</button><button class="text-button" data-save-dossier type="button" aria-pressed="true">Saved · Remove</button></div></div></div></>}
  {slug === 'account/addresses' && <div class="account-welcome"><p class="eyebrow">Digital delivery</p><h2>No shipping address needed.</h2><p>Our single product is a digital dossier. There is no physical delivery address to maintain. Billing or delivery details required by a future payment provider will be explained before purchase.</p><a class="inline-link" href={withBase('shipping-returns/')}>Read about digital delivery →</a></div>}
  {slug === 'account/payment-methods' && <div class="account-welcome"><p class="eyebrow">No saved cards</p><h2>Your card details stay out of this preview.</h2><p>No payment provider is connected. Live payment and saved-card controls will only appear once secure checkout is available.</p><a class="inline-link" href={withBase('dossier/')}>View the dossier offer →</a></div>}
  {slug === 'account/subscriptions' && <div class="account-welcome"><p class="eyebrow">No active subscriptions</p><h2>The dossier is a one-time purchase.</h2><p>There is no membership, recurring charge, renewal date, or subscription to cancel. The proposed price is {dossier.priceLabel} for the digital dossier.</p><a class="inline-link" href={withBase('account/orders/')}>View order history →</a></div>}
  </div>
</div>

---
import ThemeToggle from './ThemeToggle.astro'
import { withBase } from '@/data/register'
import { dossier } from '@/data/dossier'
interface Props { current?: string }
const { current } = Astro.props
---
<div class="announcement">One product per category. Or none. <span>Independent judgment. Public reasoning.</span></div>
<header class="shop-header">
  <div class="shell shop-header-row">
    <a class="brand" href={withBase()} aria-label="Platonic Ideal home"><span class="brand-mark" aria-hidden="true"></span><span>Platonic Ideal</span></a>
    <nav class="shop-nav" aria-label="Primary navigation">
      <a href={withBase('register/')} aria-current={current === 'register' ? 'page' : undefined}>The catalog</a>
      <a href={withBase('dossier/')} aria-current={current === 'dossier' ? 'page' : undefined}>The dossier</a>
      <a href={withBase('journal/')} aria-current={current === 'journal' ? 'page' : undefined}>Journal</a>
      <a href={withBase('methodology/')} aria-current={current === 'methodology' ? 'page' : undefined}>Our approach</a>
    </nav>
    <div class="shop-tools">
      <a href={withBase('search/')} aria-label="Search" aria-current={current === 'search' ? 'page' : undefined} class="icon-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
      <ThemeToggle />
    </div>
    <a class="button nav-offer" href={withBase('dossier/')} data-analytics-event="dossier_cta_click" data-analytics-item-id={dossier.id} data-analytics-item-name={dossier.name} data-analytics-item-category="digital_dossier" data-analytics-item-price={dossier.price} data-analytics-item-list-name="site_header" data-analytics-value={dossier.price} data-analytics-currency="USD" data-analytics-edition-id={dossier.editionId}>Get the dossier <span>{dossier.priceLabel} ↗</span></a>
  </div>
</header>

---
import Meander from './Meander.astro'
import ThemeToggle from './ThemeToggle.astro'
import { registerStats, withBase } from '@/data/register'

interface Props { current?: 'index' | 'methodology' }
const { current } = Astro.props
---

<header class="site-header">
  <div class="shell">
    <div class="header-row">
      <a class="brand" href={withBase()} aria-label="Platonic Ideal home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>Platonic Ideal</span>
      </a>
      <nav class="primary-nav" aria-label="Primary navigation">
        <a href={withBase('#register')} aria-current={current === 'index' ? 'page' : undefined}>The Register</a>
        <a href={withBase('methodology/')} aria-current={current === 'methodology' ? 'page' : undefined}>Method</a>
      </nav>
      <div class="header-actions">
        <span class="edition mono label">N = {registerStats.total}</span>
        <ThemeToggle />
      </div>
    </div>
    <Meander />
  </div>
</header>

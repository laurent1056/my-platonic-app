---
import ThemeToggle from './ThemeToggle.astro'
import { withBase } from '@/data/register'
import { dossier } from '@/data/dossier'
interface Props { current?: string }
const { current } = Astro.props
---
<div class="announcement">One product per category. Or none. <span>Independent judgment. Public reasoning.</span></div>
<header class="shop-header">
  <div class="shell shop-header-row">
    <a class="brand" href={withBase()} aria-label="Platonic Ideal home"><span class="brand-mark" aria-hidden="true"></span><span>Platonic Ideal</span></a>
    <nav class="shop-nav" aria-label="Primary navigation">
      <a href={withBase('register/')} aria-current={current === 'register' ? 'page' : undefined}>The catalog</a>
      <a href={withBase('dossier/')} aria-current={current === 'dossier' ? 'page' : undefined}>The dossier</a>
      <a href={withBase('journal/')}>Journal</a>
      <a href={withBase('methodology/')} aria-current={current === 'methodology' ? 'page' : undefined}>Our approach</a>
    </nav>
    <div class="shop-tools">
      <a href={withBase('search/')} aria-label="Search" class="icon-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
      <a href={withBase('account/')} aria-label="Account" class="icon-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="7" r="3.5"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></a>
      <a href={withBase('cart/')} aria-label="Cart" class="icon-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg><span data-cart-count class="cart-dot" hidden>1</span></a>
      <ThemeToggle />
    </div>
    <a class="button nav-offer" href={withBase('dossier/')}>Get the dossier <span>{dossier.priceLabel} ↗</span></a>
  </div>
</header>

---
import { imageSourceFor, type ImageSourceRecord } from '@/data/image-sources'

interface Props {
  productId: string
}

const source: ImageSourceRecord | undefined = imageSourceFor(Astro.props.productId)
const availabilityLabel = source?.imageAvailability === 'confirmed'
  ? 'Image-bearing page located'
  : source?.imageAvailability === 'lead'
    ? 'Source lead needs exactness review'
    : 'Current source not located'
const identityLabel = source?.identityStatus === 'exact'
  ? 'Exact model'
  : source?.identityStatus === 'family'
    ? 'Family match'
    : source?.identityStatus === 'ambiguous'
      ? 'Identity unresolved'
      : 'Generic subject'
const rightsLabel = source?.rightsStatus === 'owned' || source?.rightsStatus === 'licensed'
  ? 'Image rights cleared'
  : source?.rightsStatus === 'not-for-republish'
    ? 'Republication not cleared'
    : 'Rights unknown'
---

{source && (
  <aside class="source-reference" aria-label="Image source record">
    <div class="source-reference-heading">
      <p class="label">Image source record</p>
      <span class:list={['source-reference-state', { confirmed: source.imageAvailability === 'confirmed' }]}>
        {availabilityLabel}
      </span>
    </div>
    <p class="source-reference-title">{source.sourcePageTitle}</p>
    <p class="source-reference-maker mono">{source.sellerOrManufacturer} · {source.exactModel}</p>
    {source.sourceUrl ? (
      <a class="source-reference-link" href={source.sourceUrl} target="_blank" rel="noopener noreferrer">
        Inspect current source <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <span class="source-reference-link muted-link">No current source page recorded</span>
    )}
    <div class="source-reference-facts mono">
      <span>Identity · {identityLabel}</span>
      <span>Use · {source.recommendedUse.replace(/-/g, ' ')}</span>
      <span>Rights · {rightsLabel}</span>
    </div>
    <p class="source-reference-note">{source.notes}</p>
  </aside>
)}

---
import { publicStateDescription, publicStateLabel, type SourceStatus, type Verdict } from '@/data/register'

interface Props {
  verdict: Verdict
  sourceStatus?: SourceStatus
}

const { verdict, sourceStatus } = Astro.props
const variant = verdict === 'DECLARED' ? 'declared' : verdict === 'EMPTY' ? 'empty' : 'review'
const label = publicStateLabel(verdict, sourceStatus)
const description = publicStateDescription(verdict, sourceStatus)
---

<span class:list={['chip', variant]} title={description}>{label}</span>

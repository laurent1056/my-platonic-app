---
import { dossier } from '@/data/dossier'
import { withBase } from '@/data/register'
interface Props { compact?: boolean; context?: string }
const { compact = false, context } = Astro.props
---
<aside class:list={['dossier-offer', { 'offer-compact': compact }]} aria-label="The dossier">
  <div><p class="eyebrow">The research, brought together</p><h2>{context ? `Go deeper on ${context.toLowerCase()}.` : 'Good judgment. In one place.'}</h2><p>The verdict is free. Get the 48-recommendation dossier for the research behind a more considered purchase.</p></div>
  <div class="offer-action"><a class="button" data-analytics-event="dossier_cta_click" data-analytics-item-id={dossier.id} data-analytics-item-name={dossier.name} data-analytics-item-category="digital_dossier" data-analytics-item-price={dossier.price} data-analytics-item-list-name={context ? `category_${context}` : 'site_offer'} data-analytics-value={dossier.price} data-analytics-currency="USD" data-analytics-edition-id={dossier.editionId} href={withBase('dossier/')}>Get the dossier <span>{dossier.priceLabel} ↗</span></a><span class="fine-print">{dossier.coverage} · One-time purchase</span></div>
</aside>

---
import ProductGlyph from './ProductGlyph.astro'
import { approvedHeroImageFor, type ProductImage as ProductImageRecord } from '@/data/product-images'
import type { RegisterEntry } from '@/data/register'
import { withBase } from '@/data/register'

interface Props {
  entry: Pick<RegisterEntry, 'reference' | 'category' | 'model' | 'hasRealImage' | 'imageUrl'>
  priority?: boolean
}

const { entry, priority = false } = Astro.props
const image: ProductImageRecord | undefined = approvedHeroImageFor(entry.reference)
---

{image ? (
  <figure class="product-image-plate">
    <img
      class="specimen-image editorial-product-image"
      src={withBase(image.path)}
      alt={image.alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
    />
    <figcaption class="product-image-caption">
      <span class="label">{image.kind === 'editorial-interpretation' ? 'Interpretive plate' : 'Product image'}</span>
      <span>{image.caption}</span>
    </figcaption>
  </figure>
) : (
  <ProductGlyph entry={entry} />
)}


---
interface Props { value: number }
const value = Math.max(0, Math.min(5, Astro.props.value || 0))
---

<span class="confidence" aria-label={`Confidence ${value} of 5`}>
  <span class="confidence-bars" aria-hidden="true">
    {Array.from({ length: 5 }, (_, index) => <i class:list={{ filled: index < value }}></i>)}
  </span>
  <output>{value || '—'}</output>
</span>

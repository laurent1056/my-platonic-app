<button class="icon-button" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
  <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
</button>

<script>
  const root = document.documentElement
  const button = document.querySelector('[data-theme-toggle]')

  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme
    localStorage.setItem('PI_THEME', theme)
    button?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`)
  }

  const stored = localStorage.getItem('PI_THEME')
  if (stored === 'light' || stored === 'dark') applyTheme(stored)

  button?.addEventListener('click', () => {
    const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    applyTheme(current === 'dark' ? 'light' : 'dark')
  })
</script>

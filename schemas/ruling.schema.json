{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://my-platonic-app.vercel.app/schemas/ruling.schema.json",
  "title": "Platonic Ideal ruling ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["constitutionVersion", "events"],
  "properties": {
    "constitutionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rulingId",
        "caseId",
        "eventType",
        "verdict",
        "constitutionVersion",
        "recordedOn",
        "summary",
        "evidenceIds"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^PI-RE-[0-9]{6}$" },
        "rulingId": { "type": "string", "pattern": "^PI-R-[0-9]{4}$" },
        "caseId": { "type": "string", "pattern": "^PI-C-[0-9]{4}$" },
        "eventType": { "enum": ["ISSUED", "CONFIRMED", "AMENDED", "DEPRECATED", "REVOKED"] },
        "verdict": { "enum": ["DECLARED", "EMPTY"] },
        "constitutionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "recordedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^PI-E-[0-9]{6}$" }, "uniqueItems": true },
        "supersedesRulingId": { "type": "string", "pattern": "^PI-R-[0-9]{4}$" }
      }
    }
  }
}
